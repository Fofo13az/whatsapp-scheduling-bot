# ============================================================
# WhatsApp Scheduling Bot — Variables de entorno
# ============================================================
# Copiar este archivo a .env y llenar con valores reales.
# NUNCA commitear .env al repositorio.
# ============================================================

# ─── Generales ─────────────────────────────────────────────
NODE_ENV=development                     # development | production
PORT=3000
TIMEZONE=America/Mexico_City
LOG_LEVEL=info                           # trace | debug | info | warn | error

# ─── WhatsApp Cloud API (Meta) ─────────────────────────────
# Todo se obtiene en https://developers.facebook.com → tu App → WhatsApp
#
# Token de acceso. Para desarrollo sirve el token temporal (24h) de
# App → WhatsApp → API Setup. Para producción, generar un token permanente
# de System User en Meta Business Suite.
WHATSAPP_TOKEN=

# Phone Number ID del número emisor (NO es el teléfono). Aparece en
# App → WhatsApp → API Setup. En Fases 1-3 usar el número de TEST que
# Meta regala (permite hasta 5 destinatarios verificados).
# En Fase 4+ será el ID del número real del consultorio.
WHATSAPP_PHONE_NUMBER_ID=

# String arbitrario (≥8 chars) que TÚ inventas. Se pega idéntico en
# App → WhatsApp → Configuration → Webhook al registrar la URL del webhook.
WHATSAPP_VERIFY_TOKEN=

# App Secret (App → Settings → Basic). Valida la firma HMAC de los webhooks.
META_APP_SECRET=

# Versión de la Graph API (opcional, default v25.0)
GRAPH_API_VERSION=v25.0

# ─── Doctora ───────────────────────────────────────────────
# WhatsApp personal de la doctora — recibe notificaciones del bot
# Formato E.164 con "+" (México celular: +521 + 10 dígitos)
DOCTOR_PERSONAL_PHONE=+5215512345678
DOCTOR_NAME=Dra. Ejemplo

# ─── CalDAV (Apple Calendar) ───────────────────────────────
CALDAV_SERVER_URL=https://caldav.icloud.com
CALDAV_USERNAME=correo@icloud.com

# Generar en appleid.apple.com → Sign-In and Security → App-Specific Passwords
# Formato: xxxx-xxxx-xxxx-xxxx
CALDAV_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Un calendario POR CONSULTORIO (nombre EXACTO como aparece en Apple
# Calendar). Las citas se crean en el calendario del consultorio elegido;
# la disponibilidad lee ambos (un evento en cualquiera bloquea el horario
# en los dos — la doctora no puede estar en dos lugares a la vez).
# IMPORTANTE: en Fase 1-3 usar calendarios de PRUEBA, no los reales
CALDAV_CALENDAR_SUR=Citas Sur Test
CALDAV_CALENDAR_NORTE=Citas Norte Test

# Fallback: si un consultorio no tiene var propia, usa este calendario.
# Útil para pruebas con un solo calendario; en producción déjalo vacío.
CALDAV_CALENDAR_NAME=

# ─── Google Calendar (service account) ─────────────────────
# Para consultorios cuyo calendario vive en GOOGLE en vez de iCloud (el de
# Sur: es un Google Calendar compartido con la secretaria, que agenda
# desde Android). Setup completo en docs/GOOGLE_CALENDAR.md.
#
# Si GOOGLE_CALENDAR_<CONSULTORIO> está definido, ese consultorio se rutea a
# Google y su var CALDAV_CALENDAR_* se ignora. La doctora debe compartir el
# calendario con el email de la service account ("Hacer cambios en eventos").
#
# GOOGLE_CALENDAR_*: el ID del calendario (Google Calendar → configuración
# del calendario → "ID del calendario"; para el principal es el gmail).
GOOGLE_SA_EMAIL=
# La llave privada del JSON de la service account (campo private_key), en UNA
# línea con los saltos escapados como \n:
# GOOGLE_SA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_SUR=
GOOGLE_CALENDAR_NORTE=

# ─── Scheduler ─────────────────────────────────────────────
# Hora a la que se envían recordatorios cada noche (formato HH:MM, 24h)
REMINDER_TIME=20:00

# Horas después del recordatorio para revisar quién no ha respondido
# y avisarle a la doctora (toggle NOTIFY_NO_RESPONSE)
REMINDER_FOLLOWUP_HOURS=2

# Nombre del template de Meta aprobado para el recordatorio nocturno
# (ver docs/TEMPLATES.md). VACÍO en desarrollo: el recordatorio sale como
# mensaje interactivo de sesión. Al aprobarse el template (Fase 4):
# REMINDER_TEMPLATE_NAME=appointment_reminder
REMINDER_TEMPLATE_NAME=

# Notificaciones a la doctora directo por template doctor_* (su ventana de
# 24h casi siempre está cerrada en producción y el mensaje de sesión puede
# perderse en silencio — Meta lo acepta y lo rechaza async).
# Encender SOLO cuando Meta apruebe los templates 3-8 de docs\TEMPLATES.md.
DOCTOR_TEMPLATES_ENABLED=false

# ─── Disponibilidad ────────────────────────────────────────
# Días hacia adelante que el bot explora buscando fechas con espacio.
# La agenda se llena con ~1 mes de anticipación; 60 cubre ~2 meses.
AVAILABILITY_SEARCH_DAYS=60

# ─── Lista de espera ───────────────────────────────────────
# Si la cita de una paciente queda a este número de días (o más), el bot
# le ofrece unirse a la lista de espera para tomar huecos liberados.
WAITLIST_MIN_DAYS_AHEAD=7

# Template de Meta aprobado para ofrecer un hueco liberado a una paciente
# de la lista de espera (ver docs/TEMPLATES.md). VACÍO en desarrollo (la
# oferta sale como mensaje de sesión). Al aprobarse (Fase 4):
# WAITLIST_OFFER_TEMPLATE_NAME=waitlist_slot_offer
WAITLIST_OFFER_TEMPLATE_NAME=

# ─── Notificaciones a la doctora (toggles) ────────────────
# Cada uno puede ser true o false. Permite a la doctora decidir
# qué eventos quiere que le avisen sin tocar código.
NOTIFY_NEW_APPOINTMENT=true
NOTIFY_CONFIRMATION=true
NOTIFY_CANCELLATION=true
NOTIFY_NO_RESPONSE=true
NOTIFY_RESCHEDULE=true

# ─── Base de datos (MySQL) ─────────────────────────────────
# En desarrollo: tu MySQL local. En Railway: las credenciales del addon.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=whatsapp_bot

# Tamaño del pool de conexiones. 10 está bien para producción modesta.
MYSQL_CONNECTION_LIMIT=10


# ─── Sesión / seguridad ────────────────────────────────────
# Tiempo de inactividad después del cual el flujo conversacional
# se reinicia (en minutos)
CONVERSATION_TIMEOUT_MIN=30
